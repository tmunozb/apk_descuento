<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: gradiente profundo -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/gg_navy_900"
                android:centerColor="@color/gg_navy_800"
                android:endColor="@color/gg_navy_700"/>
        </shape>
    </item>

    <!-- Capa 2: viñeta para legibilidad inferior -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="1.1"
                android:gradientRadius="1100dp"
                android:startColor="#00000000"
                android:endColor="#18000000"/>
        </shape>
    </item>

    <!-- Capa 3: “glow” superior tenue -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="-0.4"
                android:gradientRadius="900dp"
                android:startColor="#10FFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
