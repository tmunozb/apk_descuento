<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base blanca -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
        </shape>
    </item>

    <!-- Viñetas azules desde los bordes hacia el centro -->
    <!-- Izquierda -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="-0.3"
                android:centerY="0.5"
                android:gradientRadius="700dp"
                android:startColor="#00233B"
            android:centerColor="#1A233B5A"
            android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Derecha -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="1.3"
                android:centerY="0.5"
                android:gradientRadius="700dp"
                android:startColor="#00233B"
                android:centerColor="#1A233B5A"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Arriba -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="-0.3"
                android:gradientRadius="700dp"
                android:startColor="#00233B"
                android:centerColor="#1A233B5A"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Abajo -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="1.3"
                android:gradientRadius="700dp"
                android:startColor="#00233B"
                android:centerColor="#1A233B5A"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Trazo exterior muy sutil (marco) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="#1A0E3A66"/> <!-- navy 10% -->
        </shape>
    </item>

</layer-list>
