<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- TOOLBAR -->
    <!-- styles_comercial.xml -->
    <style name="Widget.Farenet.Toolbar.Comercial" parent="Widget.Material3.Toolbar">
        <item name="backgroundTint">@color/tile_bg</item>
        <!-- Si vas a dejar el título vacío en el XML, estos colores no afectan -->
        <item name="titleTextColor">@color/tile_title</item>
        <item name="subtitleTextColor">@color/tile_subtitle</item>
        <item name="navigationIconTint">@color/tile_title</item>
        <item name="popupTheme">@style/ThemeOverlay.Material3.Light</item>
    </style>


    <!-- BottomNavigation con indicador activo por defecto (Material3) -->
    <style name="Widget.Farenet.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_tint</item>
        <item name="itemTextColor">@color/bottom_nav_tint</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ESQUINA REDONDEADA -->
    <style name="Shape.Farenet.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Card genérica: SIN layout_width/height/margin -->
    <style name="DashboardCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="rippleColor">?attr/colorSecondary</item>
        <item name="shapeAppearance">@style/Shape.Farenet.Card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Base genérica para cualquier toolbar de la app -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="backgroundTint">@color/tile_bg</item>
        <item name="titleTextColor">@color/tile_title</item>
        <item name="subtitleTextColor">@color/tile_subtitle</item>
        <item name="navigationIconTint">@color/tile_title</item>
        <item name="popupTheme">@style/ThemeOverlay.Material3.Light</item>
    </style>

    <!-- (Opcional) Sistemas, por si luego diferencias -->
    <style name="Widget.Farenet.Toolbar.Sistemas" parent="Widget.App.Toolbar" />

    <!-- Variante ancha (sólo cambia lógica de layout, la pones en el XML) -->
    <style name="DashboardCardLarge" parent="DashboardCard" />

    <!-- Tiles claros -->
    <style name="Widget.Farenet.ActionTile" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/tile_bg</item>
        <item name="strokeColor">@color/tile_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="rippleColor">?attr/colorSecondary</item>
        <item name="shapeAppearance">@style/Shape.Farenet.Card</item>
    </style>

    <!-- KPIs -->
    <style name="Widget.Farenet.KpiCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/tile_bg</item>
        <item name="strokeColor">@color/tile_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="ShapeAppearance.Farenet.Circle" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- CHIPS / SEARCH -->
    <style name="Widget.Farenet.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/tile_bg</item>
        <item name="chipStrokeColor">@color/tile_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/tile_title</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxStrokeColor">@color/gg_outline_idle</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/gg_text_muted</item>
        <item name="startIconTint">@color/gg_text_muted</item>
        <item name="endIconTint">@color/gg_text_muted</item>
        <item name="android:textColor">@color/gg_text_main</item>
        <item name="errorIconTint">@color/gg_error</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Farenet.Search" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/tile_bg</item>
        <item name="boxStrokeColor">@color/tile_stroke</item>
        <item name="hintTextColor">@color/tile_subtitle</item>
    </style>

    <!-- TEXTOS -->
    <style name="Text.Farenet.HeroTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/hero_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Farenet.HeroSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/hero_subtitle</item>
    </style>
    <style name="Text.Farenet.KpiLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/tile_subtitle</item>
    </style>
    <style name="Text.Farenet.KpiValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/tile_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botón primario sobrio -->
    <style name="Widget.Farenet.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/gg_navy_700</item>
        <item name="android:textColor">@color/gg_text_main</item>
        <item name="iconTint">@color/gg_text_main</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/gg_ripple_cyan</item>
        <!-- glow al presionar -->
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- Botón secundario: contorno mostaza apagado -->
    <style name="Widget.Farenet.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_yellow</item>
        <item name="android:textColor">@color/brand_yellow</item>
        <item name="iconTint">@color/brand_yellow</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Inputs con borde navy al foco -->
    <style name="Widget.Farenet.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
         <item name="boxStrokeColor">@color/ui_border_blue</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="hintTextColor">@color/ui_text_hint</item>
        <item name="startIconTint">@color/ui_border_blue</item>
        <item name="endIconTint">@color/ui_border_blue</item>
    </style>

    <!-- Tarjeta del formulario: menos brillo, borde sutil -->
    <style name="Widget.Farenet.LoginCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/gg_surface</item>
        <item name="strokeColor">@color/gg_surface_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Título: peso moderado, tracking neutro -->
    <style name="Text.Farenet.LoginTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Farenet.Button.Primary.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ui_border_blue</item>
        <item name="android:textColor">@color/ui_border_blue</item>
        <item name="iconTint">@color/ui_border_blue</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">#140E3A66</item>
    </style>




</resources>
