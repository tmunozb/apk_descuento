<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Cabecera: Código · Fecha · Estado -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCodigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:text="COD-00001" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-01-01 12:00"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chEstado"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente" />
        </LinearLayout>

        <!-- Línea: Tipo · Placa -->
        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descuento"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvPlaca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABC-123"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Planta -->
        <TextView
            android:id="@+id/tvPlanta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Planta Lima"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Concepto (nuevo / opcional para adapter) -->
        <TextView
            android:id="@+id/tvConcepto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Concepto: LIV - Liviano"
            android:textColor="?attr/colorOnSurface"
            android:visibility="visible" />

        <!-- Motivo -->
        <TextView
            android:id="@+id/tvMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motivo de la solicitud"
            android:textColor="?attr/colorOnSurface" />
        <TextView
            android:id="@+id/tvAprobado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aprobó: —"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Fila: Monto y Aprobado (nuevos / opcionales para adapter) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvMonto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monto: S/ 0.00"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />


        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
