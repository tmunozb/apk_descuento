<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/fn_bg">

    <!-- CONTENIDO: AppBar + Scroll + BottomNav -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@color/fn_bg">

        <!-- AppBar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:liftOnScroll="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.Farenet.Toolbar.Comercial"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:logo="@drawable/ic_logo_farenet"
                app:logoDescription="@string/app_name"
                app:title="" />

            <!-- OJO: sin app:menu: el menú vive en el NavigationView -->
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenido scrollable -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:paddingBottom="80dp"
            android:background="@color/fn_bg"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_dodgeInsetEdges="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/fn_bg">

                <!-- Hero -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_hero_comercial"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvWelcome"
                            style="@style/Text.Farenet.HeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¡Hola, Comercial!" />

                        <TextView
                            android:id="@+id/tvSubtitle"
                            style="@style/Text.Farenet.HeroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gestiona solicitudes" />
                    </LinearLayout>
                </FrameLayout>

                <!-- KPIs rápidos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Farenet.KpiCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Farenet.KpiLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pend. Aut." />

                            <TextView
                                android:id="@+id/tvKpiPendientes"
                                style="@style/Text.Farenet.KpiValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Farenet.KpiCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Farenet.KpiLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aprobadas" />

                            <TextView
                                android:id="@+id/tvKpiAprobadas"
                                style="@style/Text.Farenet.KpiValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="38" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Acciones (grid) -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridAcciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    app:columnCount="2"
                    app:rowOrderPreserved="false"
                    app:alignmentMode="alignMargins"
                    app:useDefaultMargins="true">

                    <!-- Bolsa Estado -->
                    <include
                        android:id="@+id/tileBolsaEstado"
                        layout="@layout/item_action_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:layout_columnWeight="1" />

                    <!-- Pendientes (Aut.) -->
                    <include
                        android:id="@+id/tilePendientesAut"
                        layout="@layout/item_action_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:layout_columnWeight="1" />

                    <!-- Historial -->
                    <include
                        android:id="@+id/tileHistorial"
                        layout="@layout/item_action_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:layout_columnWeight="1" />

                    <!-- Reportes -->
                    <include
                        android:id="@+id/tileReportes"
                        layout="@layout/item_action_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:layout_columnWeight="1" />
                </androidx.gridlayout.widget.GridLayout>

                <!-- Buscador (aplica a "Últimas solicitudes") -->
                <TextView
                    android:id="@+id/tvSearchSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:text="Buscar en últimas solicitudes"
                    android:textStyle="bold"
                    android:textColor="@color/cardTitle" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuscarUltimos"
                    style="@style/Widget.Farenet.Search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    app:startIconDrawable="@drawable/ic_search_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBuscarUltimos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Placa o código…"
                        android:textColor="@color/tile_title"
                        android:textColorHint="@color/tile_subtitle"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Lista “últimas solicitudes” -->
                <TextView
                    android:id="@+id/tvSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:text="Últimas solicitudes"
                    android:textStyle="bold"
                    android:textColor="@color/cardTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUltimos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:clipToPadding="false"
                    android:background="@color/fn_bg" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation (solo comercial) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.Farenet.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
            app:menu="@menu/menu_bottom_comercial" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- MENÚ LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu_selection_comercial"
        app:headerLayout="@layout/nav_header_selection"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint" />

</androidx.drawerlayout.widget.DrawerLayout>
