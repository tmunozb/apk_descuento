<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cortesia_title"
            android:textAlignment="center"
            android:textColor="@color/fareazul"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:paddingTop="4dp"
            android:paddingBottom="12dp" />

        <!-- Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Planta -->
                <Spinner
                    android:id="@+id/sp_planta_cort"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinner"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_dropdown" />

                <!-- Placa -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.App.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/placa"
                    app:counterEnabled="true"
                    app:counterMaxLength="17"
                    app:startIconDrawable="@drawable/ic_directions_car_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtPlaca_cort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="7"
                        android:textAllCaps="true"
                        android:imeOptions="actionNext"
                        tools:text="ABC123" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Motivo (dropdown de solo lectura con lista de la API) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/motivo"
                    app:helperTextEnabled="true"
                    app:helperText="@string/selecciona_un_motivo"
                    app:startIconDrawable="@drawable/ic_note_24"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvMotivo_cort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:importantForAutofill="no"
                        tools:text="Reclamo" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Autoriza (solo lectura, viene del login) -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.App.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/autoriza"
                    app:startIconDrawable="@drawable/ic_person_24">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txtAutoriza_cort_readonly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:focusable="false"
                        android:clickable="false"
                        tools:text="Juan Pérez (logueado)" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar_cort"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agregar"
            app:icon="@drawable/ic_save_24"
            app:iconGravity="textStart"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
