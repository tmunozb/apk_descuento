<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.farenet.descuentos">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Ver apps que manejan ACTION_SEND text/plain -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- Paquetes específicos de WhatsApp -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".Core.app.BaseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ico_descuento"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ico_descuento"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:usesCleartextTraffic="true">

        <!-- Todas las Activities heredan Theme.App (no mezclar MaterialComponents) -->
        <activity
            android:name=".ui.solicitudes.historial.HistorialSolicitudesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.solicitudes.pendientes.SolicitudesPendientesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.solicitudes.lista.SolicitudesListaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.solicitudes.crear.SolicitudCrearActivity"
            android:exported="false" />

        <activity
            android:name=".ui.selection.SelectionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.solicitudes.descuento.DescuentoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.solicitudes.cortesia.CortesiaActivity"
            android:exported="false" />

        <!-- Corrige: antes tenía Theme.MaterialComponents... cámbialo a Theme.App -->
        <activity
            android:name=".ui.comercialhost.ComercialHostActivity"
            android:exported="false"
            android:theme="@style/Theme.App" />

        <activity
            android:name=".ui.bootstrap.BootstrapActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.bolsa.BolsaEstadoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.bolsa.BolsaBulkActivity"
            android:exported="false" />

        <!-- BaseSelectionActivity puede estar declarado aunque sea base (no se lanzará) -->
        <activity
            android:name=".ui.selection.base.BaseSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.selection.sistemas.SelectionSistemasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.selection.operaciones.SelectionOperacionesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.selection.comercial.SelectionComercialActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".ui.selection.asistente.SelectionAsistenteActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
